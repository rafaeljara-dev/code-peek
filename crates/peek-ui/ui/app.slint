                                            }
                                        }
                                        changed scroll-seq => { self.reveal(); }
                                        init => { self.reveal(); }
                                        preferred-height: block-body.preferred-height;
                                        min-height: block-body.preferred-height;
                                        border-radius: 6px;
                                        background: block.selected ? Theme.code-selection : block.highlighted ? Theme.find-surface : block.kind == 4 ? Theme.sidebar : block.kind == 2 ? (Theme.light ? #f1f5f9 : #192534) : transparent;
                                        border-width: block.kind == 4 || block.highlighted ? 1px : 0px;
                                        border-color: block.highlighted ? Theme.focus : Theme.border;
                                        TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            pointer-event(e) => {
                                                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
