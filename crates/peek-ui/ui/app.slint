                                                }
                                            }
                                        }
                                        ContextMenuArea {
                                            width: 100%;
                                            height: 100%;
                                            Menu {
                                                MenuItem { title: "Copiar bloque"; activated => { root.select-doc-block(block.index, false); root.copy-doc-selection(); } }
                                                MenuItem { title: "Copiar selección"; activated => { root.copy-doc-selection(); } }
                                                MenuItem { title: "Copiar todo el documento"; activated => { root.copy-doc-all(); } }
                                            }
                                        }
                                        block-body := VerticalLayout {
                                            padding-left: block.kind == 4 || block.kind == 5 || block.kind == 7 ? 0px : 6px;
                                            padding-right: block.kind == 4 || block.kind == 5 || block.kind == 7 ? 0px : 6px;
                                            padding-top: block.kind == 1 ? (block.level == 1 ? 8px : block.level == 2 ? 14px : 8px) : block.kind == 4 || block.kind == 5 ? 0px : 3px;
                                            padding-bottom: block.kind == 1 && block.level <= 2 ? 6px : block.kind == 4 || block.kind == 5 ? 0px : 3px;
                                            spacing: 8px;
                                            alignment: start;

                                            if block.kind == 1: VerticalLayout {
                                                spacing: 8px;
                                                if block.lines.length == 0: Text {
                                                    text: block.plain-text;
                                                    color: Theme.heading;
                                                    font-size: root.doc-font + (block.level == 1 ? 11px : block.level == 2 ? 7px : block.level == 3 ? 3px : 1px);
                                                    font-weight: 700;
                                                    wrap: word-wrap;
                                                }
                                                if block.lines.length > 0: DocRichLines {
                                                    lines: block.lines;
                                                    body-font-size: root.doc-font + (block.level == 1 ? 11px : block.level == 2 ? 7px : block.level == 3 ? 3px : 1px);
                                                    code-font-family: root.code-font-family;
                                                    heading-mode: true;
                                                    default-color: Theme.heading;
                                                }
                                                if block.level <= 2: Rectangle { height: 1px; background: Theme.border; }
                                            }
                                            if block.kind == 0: VerticalLayout {
                                                spacing: 6px;
                                                if block.lines.length == 0: Text {
                                                    text: block.plain-text;
                                                    color: Theme.file-text;
                                                    font-size: root.doc-font + 1px;
                                                    wrap: word-wrap;
                                                }
                                                if block.lines.length > 0: DocRichLines {
                                                    lines: block.lines;
                                                    body-font-size: root.doc-font + 1px;
                                                    code-font-family: root.code-font-family;
                                                }
                                            }
                                            if block.kind == 2: HorizontalLayout {
                                                padding: 10px; spacing: 12px;
                                                Rectangle {
                                                    width: 4px; border-radius: 2px;
                                                    background: block.level == 1 ? #38bdf8 : block.level == 2 ? #34d399 : block.level == 3 ? #a78bfa : block.level == 4 ? #fbbf24 : block.level == 5 ? #f87171 : Theme.focus;
                                                }
                                                VerticalLayout {
                                                    horizontal-stretch: 1; spacing: 6px;
                                                    if block.prefix != "": Text {
                                                        text: block.prefix;
                                                        font-weight: 700;
                                                        font-size: root.doc-font;
                                                        color: block.level == 1 ? #38bdf8 : block.level == 2 ? #34d399 : block.level == 3 ? #a78bfa : block.level == 4 ? #fbbf24 : block.level == 5 ? #f87171 : Theme.heading;
                                                    }
                                                    if block.lines.length == 0: Text {
                                                        text: block.plain-text;
                                                        color: Theme.file-text;
                                                        font-size: root.doc-font;
                                                        font-italic: block.level == 0;
                                                        wrap: word-wrap;
                                                    }
                                                    if block.lines.length > 0: DocRichLines {
                                                        lines: block.lines;
                                                        body-font-size: root.doc-font;
                                                        code-font-family: root.code-font-family;
                                                    }
                                                }
                                            }
                                            if block.kind == 3: HorizontalLayout {
                                                padding-left: block.level * 22px + 4px; padding-right: 4px; padding-top: 1px; padding-bottom: 1px; spacing: 8px;
                                                Text {
                                                    width: 24px;
                                                    text: block.prefix;
                                                    color: block.prefix == "☑" ? #10b981 : block.prefix == "☐" ? Theme.muted : Theme.focus;
                                                    font-weight: 700;
                                                    font-size: root.doc-font + 1px;
                                                    vertical-alignment: top;
                                                }
                                                VerticalLayout {
                                                    horizontal-stretch: 1; spacing: 4px;
                                                    if block.lines.length == 0: Text {
                                                        text: block.plain-text;
                                                        color: Theme.file-text;
                                                        font-size: root.doc-font + 1px;
                                                        wrap: word-wrap;
                                                    }
                                                    if block.lines.length > 0: DocRichLines {
                                                        lines: block.lines;
                                                        body-font-size: root.doc-font + 1px;
                                                        code-font-family: root.code-font-family;
                                                    }
                                                }
                                            }
                                            if block.kind == 4: VerticalLayout {
                                                padding: 0px; spacing: 0px;
                                                Rectangle {
                                                    height: root.doc-font + 18px; background: Theme.header; border-radius: 5px;
                                                    HorizontalLayout {
                                                        padding-left: 12px; padding-right: 8px; spacing: 8px;
                                                        Text { text: block.prefix; color: Theme.muted; font-family: root.code-font-family; font-size: root.doc-font - 1px; vertical-alignment: center; horizontal-stretch: 1; }
                                                        Action { text: "Copiar"; clicked => { root.write-clipboard(block.plain-text); } }
                                                    }
                                                }
                                                ScrollView {
                                                    height: min(460px, code-inner.preferred-height + 4px);
                                                    viewport-height: code-inner.preferred-height;
                                                    viewport-width: code-inner.preferred-width;
                                                    code-inner := VerticalLayout {
                                                        padding: 12px; spacing: 4px; alignment: start;
                                                        for rline in block.lines: HorizontalLayout {
                                                            alignment: start; spacing: 0px;
                                                            for span in rline.spans: Text {
                                                                text: span.text; color: span.color;
                                                                font-family: root.code-font-family; font-size: root.code-font-size * root.doc-zoom;
                                                                font-weight: span.bold ? 700 : 400; font-italic: span.italic;
                                                            }
                                                        }
                                                    }
                                                }
                                                if block.more-lines > 0: HorizontalLayout {
                                                    padding: 6px; alignment: start;
                                                    Action { text: block.expanded ? "Contraer" : "Mostrar " + block.more-lines + " líneas más"; clicked => { root.toggle-code-block(block.index); } }
                                                }
                                            }
                                            if block.kind == 5: ScrollView {
                                                height: min(520px, tbl.preferred-height + 4px);
                                                viewport-height: tbl.preferred-height;
                                                viewport-width: tbl.preferred-width;
                                                tbl := VerticalLayout {
                                                    padding: 2px; spacing: 0px;
                                                    if block.table-headers.length > 0: Rectangle {
                                                        background: Theme.header; border-width: 1px; border-color: Theme.border;
                                                        HorizontalLayout {
                                                            padding-left: 10px; padding-right: 10px; padding-top: 7px; padding-bottom: 7px; spacing: 14px;
                                                            for h[ci] in block.table-headers: Text {
                                                                width: block.col-widths[ci] * root.doc-font / 10; text: h; color: Theme.heading;
                                                                font-weight: 700; font-size: root.doc-font; wrap: word-wrap;
                                                                horizontal-alignment: block.col-aligns[ci] == 1 ? center : block.col-aligns[ci] == 2 ? right : left;
                                                            }
                                                        }
                                                    }
                                                    for trow[ridx] in block.table-rows: Rectangle {
                                                        background: mod(ridx, 2) == 1 ? (Theme.light ? #f8fafc : #172330) : Theme.canvas;
                                                        border-width: 1px; border-color: Theme.border;
                                                        HorizontalLayout {
                                                            padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px; spacing: 14px;
                                                            for cell[ci] in trow.cells: Text {
                                                                width: block.col-widths[ci] * root.doc-font / 10; text: cell; color: Theme.file-text;
                                                                font-size: root.doc-font; wrap: word-wrap;
                                                                horizontal-alignment: block.col-aligns[ci] == 1 ? center : block.col-aligns[ci] == 2 ? right : left;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
