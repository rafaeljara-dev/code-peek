import { ListView, ScrollView, LineEdit, TextEdit, Palette, AboutSlint } from "std-widgets.slint";
import "../assets/codicon-subset.ttf";
import "../assets/devicon-subset.ttf";
export global Theme {
    in-out property <bool> light: false;
    out property <color> disabled-surface: light ? #e8edf2 : #19212b;
    out property <color> button-hover: light ? #dce8f5 : #34465a;
    out property <color> button-selected: light ? #d2e4f7 : #274e70;
    out property <color> button-surface: light ? #ffffff : #243140;
    out property <color> focus: light ? #004a91 : #8cc8ff;
    out property <color> border: light ? #c6ced7 : #34404c;
    out property <color> folder-icon: light ? #694300 : #e1b66f;
    out property <color> button-text: light ? #152233 : #e0e9f2;
    out property <color> disabled-text: light ? #35465a : #8292a3;
    out property <color> canvas: light ? #ffffff : #131c26;
    out property <color> header: light ? #edf2f7 : #1b2836;
    out property <color> heading: light ? #152233 : #edf4fc;
    out property <color> error-surface: light ? #fff0e8 : #48322c;
    out property <color> error-text: light ? #8b2500 : #ffe0cf;
    out property <color> muted: light ? #35465a : #acbfd0;
    out property <color> splitter-hover: light ? #004a91 : #638bad;
    out property <color> splitter: light ? #728196 : #263849;
    out property <color> sidebar: light ? #f5f7fa : #172330;
    out property <color> caption: light ? #35465a : #9fb0c1;
    out property <color> tree-selected: light ? #d2e4f7 : #2b455d;
    out property <color> tree-hover: light ? #e4edf6 : #26384a;
    out property <color> file-text: light ? #152233 : #dbe5ee;
    out property <color> empty-text: light ? #35465a : #aab9c8;
    out property <color> toolbar: light ? #edf2f7 : #1a2633;
    out property <color> find-surface: light ? #e4edf6 : #263b4e;
    out property <color> title: light ? #152233 : #ecf3fa;
    out property <color> description: light ? #35465a : #aebed0;
    out property <color> hint: light ? #35465a : #91a9bd;
    out property <color> line-selected: light ? #e4edf6 : #203246;
    out property <color> code-selection: light ? #d2e4f7 : #23394e;
    out property <color> line-number: light ? #35465a : #829ab0;
    out property <color> scroll-hover: light ? #334b65 : #8ba6bf;
    out property <color> scroll-thumb: light ? #52667c : #4b637a;
    out property <color> scrim: light ? #18263866 : #07111ccc;
    out property <color> dialog: light ? #ffffff : #203040;
    out property <color> dialog-border: light ? #68788a : #58728b;
    out property <color> result-selected: light ? #d2e4f7 : #34536d;
    out property <color> result-hover: light ? #e4edf6 : #2b4156;
    out property <color> result-text: light ? #152233 : #e1ebf4;
    out property <color> dialog-description: light ? #35465a : #b7c8d8;
    out property <color> dialog-hint: light ? #35465a : #a6bbcf;
    out property <color> dialog-error: light ? #8b2500 : #ffcfb5;
}

export global Typography { in-out property <length> size: 15px; }

export struct FileItem { path: string, name: string, is-dir: bool, depth: int, is-expanded: bool, icon: string, icon-family: string, icon-color: color, has-thumb: bool, thumb: image }
export struct SearchItem { path: string, display-path: string, line-number: int }
export struct ProjectItem { path: string, display-path: string, logo: image, has-logo: bool }
export struct EditorSpanItem { text: string, column: int, color: color }
export struct EditorRowItem { line-number: int, selection-start: int, selection-end: int, spans: [EditorSpanItem] }
export struct CodeSpanItem { text: string, color: color, bold: bool, italic: bool }
export struct CodeLineItem { line-number: int, continuation: bool, line-type: int, is-markdown: bool, spans: [CodeSpanItem] }
export struct DocLinkItem { label: string, url: string }
export struct DocSpanItem { text: string, color: color, bold: bool, italic: bool, strikethrough: bool, code: bool, link: string }
export struct DocRowLine { spans: [DocSpanItem] }
export struct DocTableRow { cells: [string] }
export struct DocHeadingItem { title: string, level: int, block-index: int }
export struct SheetHeaderItem { label: string, col-index: int, width: int }
export struct PdfThumbItem { page: int, image: image, has-image: bool }
export struct SheetCellItem { text: string, kind: int, col-index: int, selected: bool, matched: bool }
export struct SheetRowItem { row-number: int, cells: [SheetCellItem] }
export struct DocBlockItem {
    index: int,
    kind: int,
    level: int,
    prefix: string,
    plain-text: string,
    lines: [DocRowLine],
    table-headers: [string],
    table-rows: [DocTableRow],
    col-widths: [int],
    col-aligns: [int],
    more-lines: int,
    expanded: bool,
    has-image: bool,
    image: image,
    image-alt: string,
    links: [DocLinkItem],
    selected: bool,
    highlighted: bool,
}

component Hint inherits Rectangle {
    in property <string> text;
    width: min(600px, caption.preferred-width + 18px);
    height: caption.preferred-height + 12px;
    background: Theme.dialog;
    border-radius: 4px; border-width: 1px; border-color: Theme.border;
    caption := Text { x: 9px; y: 6px; width: parent.width - 18px; text: root.text; color: Theme.file-text; font-size: Typography.size - 1px; wrap: word-wrap; }
}

component Action inherits Rectangle {
    in property <string> text;
    in property <string> accessible-text: text;
    in property <bool> primary: false;
    in property <bool> text-left: false;
    in property <bool> enabled: true;
    in property <string> icon: "";
    horizontal-stretch: 0;
    vertical-stretch: 0;
    preferred-width: root.text == "" ? Typography.size + 19px : label.preferred-width + 24px + (root.icon == "" ? 0px : 24px);
    max-width: root.text-left ? 10000px : self.preferred-width;
    callback clicked();
    callback middle-clicked();
    min-width: root.text == "" ? self.preferred-width : root.text-left ? 40px : label.preferred-width + 20px + (root.icon == "" ? 0px : 24px);
    height: Typography.size + 17px;
    border-radius: 5px;
    background: !enabled ? Theme.disabled-surface : touch.has-hover || keys.has-focus ? Theme.button-hover : primary ? Theme.button-selected : Theme.button-surface;
    border-width: 1px;
    border-color: keys.has-focus ? Theme.focus : Theme.border;
    accessible-role: button;
    accessible-label: accessible-text;
    accessible-enabled: enabled;
    Tooltip { Hint { text: root.accessible-text; } }
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: keys;
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return { root.clicked(); return accept; }
            reject
        }
    }
    if root.icon != "": Text { text: root.icon; font-family: "codicon"; font-size: Typography.size + 2px; x: 8px; width: 20px; color: root.enabled ? Theme.button-text : Theme.disabled-text; vertical-alignment: center; }
    label := Text { text: root.text; color: root.enabled ? Theme.button-text : Theme.disabled-text; font-size: Typography.size - 1px; horizontal-alignment: root.text-left ? left : center; overflow: elide; x: root.icon == "" ? 8px : 32px; width: parent.width - self.x - 8px; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; clicked => { keys.focus(); root.clicked(); } pointer-event(e) => { if e.button == PointerEventButton.middle && e.kind == PointerEventKind.up { root.middle-clicked(); } } }
}

component DocRichLines inherits VerticalLayout {
    in property <[DocRowLine]> lines;
    in property <length> body-font-size;
    in property <string> code-font-family;
    in property <bool> heading-mode: false;
    in property <color> default-color: Theme.file-text;
    spacing: root.heading-mode ? 4px : 6px;
    alignment: start;
    for rline in root.lines: HorizontalLayout {
        alignment: start;
        spacing: 2px;
        for span in rline.spans: Rectangle {
            width: inner-text.preferred-width + (span.code ? 10px : 0px);
            height: inner-text.preferred-height + (span.code ? 2px : 0px);
            border-radius: span.code ? 4px : 0px;
            background: span.code ? (Theme.light ? #e2e8f0 : #233143) : transparent;
            border-width: span.code ? 1px : 0px;
            border-color: span.code ? (Theme.light ? #cbd5e1 : #33455e) : transparent;
            inner-text := Text {
                x: span.code ? 5px : 0px;
                y: span.code ? 1px : 0px;
                text: span.text;
                color: span.link != "" ? Theme.focus : root.heading-mode && !span.code ? root.default-color : span.color;
                font-family: span.code ? root.code-font-family : "Segoe UI";
                font-size: span.code ? max(11px, root.body-font-size - 1px) : root.body-font-size;
                font-weight: root.heading-mode || span.bold ? 700 : 400;
                font-italic: span.italic;
                vertical-alignment: center;
            }
        }
    }
}

export component MainWindow inherits Window {
    init => { Palette.color-scheme = root.light-mode ? ColorScheme.light : ColorScheme.dark; }
    in-out property <bool> light-mode: false;
    changed light-mode => { Theme.light = root.light-mode; Palette.color-scheme = root.light-mode ? ColorScheme.light : ColorScheme.dark; }
    callback toggle-theme();
    callback set-panels(bool, bool);
    title: project-name == "" ? "CodePeek" : project-name + " — CodePeek";
    icon: @image-url("../assets/icon.png");
    min-width: 960px; min-height: 600px;
    preferred-width: 1320px; preferred-height: 820px;
    background: Theme.canvas;
    default-font-family: "Segoe UI";
    default-font-size: Typography.size;
    in-out property <string> project-name;
    in-out property <string> project-path;
    in-out property <string> library-path;
    in-out property <string> default-path;
    in-out property <string> current-file-path;
    in-out property <string> selected-path;
    in-out property <string> standalone-parent-path;
    private property <length> tab-offset;
    changed selected-path => { root.tab-offset = 0px; }
    in-out property <string> status-info: "Abriendo CodePeek…";
    in-out property <string> error-message;
    in-out property <bool> is-dirty;
    in-out property <bool> busy: true;
    in-out property <bool> indexing;
    in-out property <bool> show-confirm;
    changed show-confirm => { if !root.show-confirm { root.focus-content(); } }
    in-out property <bool> show-edit;
    in-out property <bool> show-settings;
    in-out property <bool> show-about;
    in-out property <bool> markdown-file;
    in-out property <bool> is-image: false;
    in-out property <image> image-source;
    in-out property <string> image-info;
    in-out property <bool> image-actual-size: false;
    in-out property <bool> preview: false;
    callback preview-changed(bool);
    callback tree-viewport-changed(int, int);
    changed preview => { root.preview-changed(root.preview); }
    in-out property <string> document-text;
    in-out property <[EditorRowItem]> editor-rows;
    in-out property <int> caret-line: 1;
    in-out property <int> caret-column;
    in-out property <int> cursor-column: 1;
    in-out property <int> first-line: 1;
    in-out property <int> left-column;
    private property <int> focus-generation;
    in-out property <bool> can-undo;
    in-out property <bool> can-redo;
    in-out property <string> language-name;
    in-out property <bool> show-replace;
    in-out property <string> replace-query;
    in-out property <bool> find-case;
    in-out property <bool> find-whole;
    in-out property <string> find-summary;
    in-out property <bool> show-goto;
    in-out property <string> goto-input;
    in-out property <int> editor-selection-start: -1;
    in-out property <int> editor-selection-end: -1;
    callback document-edited(string, string);
    in-out property <string> project-menu-path;
    in-out property <string> project-menu-name;
    in-out property <string> edit-text;
    in-out property <int> selected-line: 1;
    in-out property <int> total-lines;
    in-out property <float> scroll-ratio;
    in-out property <float> visible-ratio: 1;
    in-out property <float> editor-scroll-ratio;
    in-out property <float> editor-visible-ratio: 1;
    in-out property <length> code-font-size: 14px;
    in-out property <string> code-font-family: "Consolas";
    in-out property <length> ui-font-size: 15px;
    changed ui-font-size => { Typography.size = self.ui-font-size; }
    out property <length> tree-font-size: root.ui-font-size;
    in-out property <[FileItem]> library-items;
    in-out property <[FileItem]> tree-items;
    in-out property <[ProjectItem]> recent-projects;
    in-out property <[SearchItem]> recent-files;
    in-out property <[SearchItem]> search-results;
    in-out property <[CodeLineItem]> code-lines;
    in-out property <[DocBlockItem]> doc-blocks;
    in-out property <[DocHeadingItem]> doc-headings;
    in-out property <bool> show-toc: false;
    in-out property <bool> doc-readonly: false;
    in-out property <int> doc-total-blocks;
    in-out property <int> doc-window-start;
    in-out property <bool> doc-has-more-before;
    in-out property <bool> doc-has-more-after;
    in-out property <float> doc-zoom: 1;
    out property <length> doc-font: Typography.size * root.doc-zoom;
    in-out property <int> doc-scroll-target: -1;
    in-out property <int> doc-scroll-seq: 0;
    private property <int> doc-scroll-done: 0;
    in-out property <bool> is-sheet: false;
    in-out property <[string]> sheet-tabs;
    in-out property <int> active-sheet: 0;
    in-out property <[SheetHeaderItem]> sheet-headers;
    in-out property <[SheetRowItem]> sheet-rows;
    in-out property <int> sheet-total-rows: 0;
    in-out property <int> sheet-total-cols: 0;
    in-out property <int> sheet-row-start: 0;
    in-out property <int> sheet-col-start: 0;
    in-out property <bool> sheet-has-prev-rows: false;
    in-out property <bool> sheet-has-next-rows: false;
    in-out property <bool> sheet-has-prev-cols: false;
    in-out property <bool> sheet-has-next-cols: false;
    in-out property <bool> sheet-truncated: false;
    in-out property <string> sheet-cell-ref;
    in-out property <string> sheet-cell-text;
    in-out property <bool> is-pdf: false;
    in-out property <int> pdf-page: 0;
    in-out property <int> pdf-total-pages: 0;
    in-out property <int> pdf-zoom-percent: 135;
    in-out property <image> pdf-image;
    in-out property <bool> pdf-loading: false;
    in-out property <bool> pdf-fit-width: true;
    in-out property <float> pdf-page-width: 0;
    in-out property <float> pdf-page-height: 0;
    in-out property <[PdfThumbItem]> pdf-thumbs;
    in-out property <float> pdf-thumb-height: 170;
    in-out property <bool> show-pdf-thumbs: true;
    in-out property <bool> markdown-default-preview: true;
    in-out property <bool> open-single-file-without-project: true;
    in-out property <bool> windows-integration-supported: false;
    in-out property <bool> windows-context-menu: true;
    in-out property <bool> windows-open-with-markdown: true;
    in-out property <bool> windows-open-with-code: true;
    in-out property <bool> windows-open-with-docs: true;
    in-out property <string> windows-integration-status;
    in-out property <int> palette-mode: 0; // 1 files, 2 projects, 4 text content
    in-out property <bool> content-searching;
    in-out property <bool> content-query-short;
    in-out property <string> query;
    in-out property <int> result-index: 0;
    in-out property <bool> show-path;
    in-out property <bool> browsing;
    in-out property <bool> show-find;
    in-out property <string> find-query;
    in-out property <string> selected-text;
    in-out property <string> path-input;
    in-out property <bool> show-library: true;
    in-out property <bool> show-tree: true;
    in-out property <length> library-width: 225px;
    in-out property <length> tree-width: 245px;
    in-out property <length> horizontal-offset: 0px;
    in-out property <length> content-width: 0px;
    private property <bool> modal: palette-mode > 0 || show-path || show-confirm || show-settings || show-about;

    callback open-project(string);
    callback open-file(string);
    callback open-at(string, int);
    callback toggle-folder(string, bool);
    callback set-library(string);
    callback set-default();
    callback go-default();
    callback library-parent();
    callback search(string, int);
    callback save();
    callback revert();
    callback reload();
    callback edit-line(int);
    callback apply-edit(string);
    callback resolve-pending(int); // cancel, discard, save
    callback scroll-lines(int);
    callback scroll-to(float);
    callback viewport-changed(int);
    callback zoom(int);
    callback zoom-ui(int);
    callback wrap-columns-changed(int);
    callback close-file(string);
    callback close-project(string);
    callback select-line(int);
    callback undo();
    callback redo();
    callback editor-command(string, string, string, bool, bool);
    callback editor-point(string, int, int, bool);
    callback editor-copy(bool);
    callback go-line(string);
    callback find-advanced(string, bool, bool, bool);
    callback replace-text(string, string, bool, bool, bool);
    callback editor-scroll(int);
    callback editor-scroll-to(float);
    callback editor-pan(int);
    callback find-text(string, bool);
    callback cancel-edit();
    callback browse-folder(string);
    callback select-doc-block(int, bool);
    callback select-doc-all();
    callback copy-doc-selection();
    callback copy-doc-all();
    callback jump-doc-block(int);
    callback step-doc-window(bool);
    callback open-doc-link(string);
    callback toggle-markdown-default-preview();
    callback toggle-single-file-mode();
    callback set-windows-integration(bool, bool, bool, bool);
    callback apply-windows-integration();
    callback select-sheet(int);
    callback step-sheet-rows(bool);
    callback step-sheet-cols(bool);
    callback select-sheet-cell(int, int);
    callback copy-sheet-cell();
    callback copy-sheet-row();
    callback pdf-step-page(int);
    callback pdf-go-page(string);
    callback pdf-zoom(int);
    callback copy-pdf-text();
    callback pdf-wheel-page(int);
    callback pdf-thumbs-viewport(int, int);
    callback zoom-doc(int);
    callback reading-width-changed(float);
    callback toggle-code-block(int);
    pure function doc-mode() -> bool { return root.preview && (root.markdown-file || root.is-sheet); }
    public function zoom-active(delta: int) {
        if root.is-pdf { root.pdf-zoom(delta); }
        else if root.doc-mode() { root.zoom-doc(delta); }
        else if delta != 0 { root.zoom(delta); }
    }

    public function copy-line() { clipboard.text = root.selected-text; clipboard.select-all(); clipboard.copy(); clipboard.text = ""; }

    public function focus-content() { main.focus(); root.focus-generation += 1; }
    public function write-clipboard(value: string) { clipboard.text = value; clipboard.select-all(); clipboard.copy(); clipboard.text = ""; }
    public function paste-content() { clipboard.text = ""; clipboard.paste(); root.editor-command(root.selected-path, "paste", clipboard.text, false, false); clipboard.text = ""; }
    public function editor-action(action: string, event: KeyEvent) { root.editor-command(root.selected-path, action, "", event.modifiers.shift, event.modifiers.control); }
    public function scroll-content(ratio: float) { if root.preview { root.scroll-to(ratio); } else { root.editor-scroll-to(ratio); } }
    public function find-next(forward: bool) { root.find-advanced(root.find-query, forward, root.find-case, root.find-whole); }
    public function open-palette(mode: int) {
        if root.modal { return; }
        root.palette-mode = mode;
        root.query = "";
        root.result-index = 0;
        root.search-results = [];
        root.search("", mode);
    }
    public function choose-result() {
        if root.result-index >= 0 && root.result-index < root.search-results.length {
            if root.palette-mode == 2 { root.open-project(root.search-results[root.result-index].path); }
            else if root.palette-mode == 4 { root.open-at(root.search-results[root.result-index].path, root.search-results[root.result-index].line-number); }
            else { root.open-file(root.search-results[root.result-index].path); }
            root.palette-mode = 0;
            root.focus-content();
        }
    }
    forward-focus: main;
    main := FocusScope {
        capture-key-pressed(e) => {
            if e.text == Key.Escape {
                if root.show-confirm { root.resolve-pending(0); }
                if root.show-edit { root.cancel-edit(); }
                root.palette-mode = 0; root.show-path = false; root.show-edit = false; root.show-settings = false;
                root.show-about = false;
                root.project-menu-path = "";
                root.show-find = false; root.show-replace = false; root.show-goto = false;
                root.edit-text = "";
                root.focus-content(); return accept;
            }
            if root.show-edit { return reject; }
            if root.palette-mode > 0 {
                if e.text == Key.DownArrow { root.result-index = min(root.result-index + 1, root.search-results.length - 1); return accept; }
                if e.text == Key.UpArrow { root.result-index = max(0, root.result-index - 1); return accept; }
                if e.text == Key.Return { root.choose-result(); return accept; }
            }
            if root.modal { return reject; }
            if e.modifiers.control && (e.text == "w" || e.text == "W" || e.text == "\u{17}") { root.close-file(root.selected-path); return accept; }
            if e.modifiers.control && e.modifiers.shift && (e.text == "f" || e.text == "F") { root.open-palette(4); return accept; }
            if e.modifiers.control && (e.text == "f" || e.text == "F" || e.text == "\u{6}") { root.show-find = true; return accept; }
            if e.modifiers.control && (e.text == "h" || e.text == "H" || e.text == "\u{8}") { root.show-find = true; root.show-replace = true; return accept; }
            if e.modifiers.control && (e.text == "g" || e.text == "G" || e.text == "\u{7}") { root.show-goto = true; return accept; }
            if root.is-pdf && e.modifiers.control && (e.text == "c" || e.text == "C" || e.text == "\u{3}") { root.copy-pdf-text(); return accept; }
            if root.is-sheet && root.preview && e.modifiers.control && (e.text == "c" || e.text == "C" || e.text == "\u{3}") { root.copy-sheet-cell(); return accept; }
            if root.preview && root.markdown-file && e.modifiers.control && (e.text == "a" || e.text == "A" || e.text == "\u{1}") { root.select-doc-all(); return accept; }
            if root.preview && e.modifiers.control && (e.text == "c" || e.text == "C" || e.text == "\u{3}") { if root.markdown-file { root.copy-doc-selection(); } else { root.copy-line(); } return accept; }
            if e.modifiers.control && (e.text == "p" || e.text == "P" || e.text == "\u{10}") { root.open-palette(e.modifiers.shift ? 2 : 1); return accept; }
            if e.modifiers.alt && (e.text == "c" || e.text == "C") { root.open-palette(2); return accept; }
            if e.modifiers.control && (e.text == "o" || e.text == "O" || e.text == "\u{f}") { root.path-input = root.project-path; root.show-path = true; return accept; }
            if e.modifiers.control && (e.text == "s" || e.text == "S" || e.text == "\u{13}") { root.save(); return accept; }
            if e.modifiers.control && (e.text == "b" || e.text == "B" || e.text == "\u{2}") {
                if e.modifiers.shift { root.show-library = !root.show-library; } else { root.show-tree = !root.show-tree; }
                root.set-panels(root.show-library, root.show-tree); return accept;
            }
            if e.modifiers.control && (e.text == "z" || e.text == "Z" || e.text == "\u{1a}") { if e.modifiers.shift { root.redo(); } else { root.undo(); } return accept; }
            if e.modifiers.control && (e.text == "+" || e.text == "=") { if e.modifiers.shift && !root.is-pdf && !root.doc-mode() { root.zoom-ui(1); } else { root.zoom-active(1); } return accept; }
            if e.modifiers.control && (e.text == "-" || e.text == "_") { if e.modifiers.shift && !root.is-pdf && !root.doc-mode() { root.zoom-ui(-1); } else { root.zoom-active(-1); } return accept; }
            if e.modifiers.control && e.text == "0" { root.zoom-active(0); return accept; }
            if e.modifiers.control && (e.text == "y" || e.text == "Y" || e.text == "\u{19}") { root.redo(); return accept; }
            if e.text == Key.F3 { root.find-next(!e.modifiers.shift); return accept; }
            if e.text == Key.F5 { root.reload(); return accept; }
            reject
        }

        clipboard := TextInput { visible: false; width: 0px; height: 0px; single-line: false; }
        key-pressed(e) => {
            if root.modal { return reject; }
            if root.is-pdf {
                if e.text == Key.PageDown || e.text == Key.RightArrow { root.pdf-step-page(1); return accept; }
                if e.text == Key.PageUp || e.text == Key.LeftArrow { root.pdf-step-page(-1); return accept; }
                reject
            }
            if root.is-sheet && root.preview {
                if e.text == Key.PageDown { root.step-sheet-rows(true); return accept; }
                if e.text == Key.PageUp { root.step-sheet-rows(false); return accept; }
                reject
            }
            if !root.preview || root.markdown-file { return reject; }
            if e.text == Key.DownArrow { root.scroll-lines(1); return accept; }
            if e.text == Key.UpArrow { root.scroll-lines(-1); return accept; }
            if e.text == Key.PageDown { root.scroll-lines(30); return accept; }
            if e.text == Key.PageUp { root.scroll-lines(-30); return accept; }
            if e.text == Key.Home { root.scroll-to(0); return accept; }
            if e.text == Key.End { root.scroll-to(1); return accept; }
            reject
        }

        VerticalLayout {
            padding: 0px; spacing: 0px;
            Rectangle {
                height: Typography.size + 42px; background: Theme.header;
                HorizontalLayout {
                    padding: 12px; spacing: 10px;
                    Action { text: "Proyectos"; accessible-text: root.show-library ? "Ocultar la lista de proyectos (Ctrl+Shift+B)" : "Mostrar la lista de proyectos (Ctrl+Shift+B)"; primary: root.show-library; clicked => { root.show-library = !root.show-library; root.set-panels(root.show-library, root.show-tree); } }
                    Action { text: "Explorador"; accessible-text: root.show-tree ? "Ocultar el explorador (Ctrl+B)" : "Mostrar el explorador (Ctrl+B)"; primary: root.show-tree; clicked => { root.show-tree = !root.show-tree; root.set-panels(root.show-library, root.show-tree); } }
                    Text { text: "CodePeek"; font-size: Typography.size + 4px; font-weight: 700; color: Theme.heading; vertical-alignment: center; }
                    Action { text: "Cambiar proyecto"; clicked => { root.open-palette(2); } }
                    Action { text: "Abrir carpeta"; clicked => { root.path-input = root.project-path; root.show-path = true; } }
                    Rectangle { horizontal-stretch: 1; }
                    Action { text: ""; icon: "\u{ea6d}"; accessible-text: "Buscar archivos o texto"; primary: true; clicked => { root.open-palette(1); } }
                    Action { text: "Configuración"; clicked => { root.show-settings = true; } }
                    Action { text: "Acerca de"; clicked => { root.show-about = true; } }
                    Action { text: ""; icon: "\u{ea77}"; accessible-text: "Recargar (F5)"; enabled: !root.busy && !root.show-edit; clicked => { root.reload(); } }
                }
            }
            if root.error-message != "": Rectangle {
                height: 54px; background: Theme.error-surface;
                HorizontalLayout {
                    padding: 10px; spacing: 12px;
                    Text { text: root.error-message; color: Theme.error-text; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                    Action { text: "Cerrar"; clicked => { root.error-message = ""; } }
                }
            }
            HorizontalLayout {
                spacing: 1px;
                if root.show-library: Rectangle {
                    width: root.library-width; background: Theme.header;
                    VerticalLayout {
                        padding: 10px; spacing: 8px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "Tus proyectos"; color: Theme.button-text; font-weight: 600; font-size: Typography.size + 1px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Action { text: "«"; accessible-text: "Ocultar la lista de proyectos (Ctrl+Shift+B)"; clicked => { root.show-library = false; root.set-panels(false, root.show-tree); root.focus-content(); } }
                        }
                        Action { text: "Abrir proyecto…"; text-left: true; clicked => { root.path-input = ""; root.show-path = true; } }
                        ListView {
                            for item in root.recent-projects: HorizontalLayout {
                                height: Typography.size + 22px; min-height: self.height; max-height: self.height; vertical-stretch: 0; spacing: 4px;
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 5px;
                                    background: item.path == root.project-path ? Theme.button-selected : project-touch.has-hover ? Theme.button-hover : Theme.button-surface;
                                    border-width: project-keys.has-focus ? 1px : 0px; border-color: Theme.focus;
                                    Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: item.path == root.project-path ? Theme.focus : transparent; }
                                    project-keys := FocusScope {
                                        key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.open-project(item.path); root.focus-content(); return accept; } reject }
                                    }
                                    accessible-role: button; accessible-label: "Abrir " + item.display-path;
                                    Tooltip { Hint { text: item.path; } }
                                    accessible-action-default => { root.project-menu-path = ""; root.open-project(item.path); root.focus-content(); }
                                    if item.has-logo: Rectangle { x: 6px; y: 5px; width: Typography.size + 10px; height: Typography.size + 10px; border-radius: 4px; background: #ffffff;
                                        Image { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; source: item.logo; image-fit: contain; }
                                    }
                                    if !item.has-logo: Text { x: 7px; width: Typography.size + 8px; text: "\u{ea83}"; font-family: "codicon"; color: Theme.folder-icon; font-size: Typography.size + 2px; vertical-alignment: center; }
                                    Text { x: Typography.size + 22px; width: parent.width - self.x - 6px; text: item.display-path; color: Theme.button-text; overflow: elide; vertical-alignment: center; }
                                    project-touch := TouchArea {
                                        clicked => { root.project-menu-path = ""; root.open-project(item.path); root.focus-content(); }
                                        pointer-event(e) => { if e.button == PointerEventButton.middle && e.kind == PointerEventKind.up { root.close-project(item.path); } }
                                    }
                                }
                                menu-button := Action { text: ""; icon: "\u{ea7c}"; accessible-text: "Opciones de " + item.display-path;
                                    clicked => { project-menu.show(); }
                                    project-menu := PopupWindow {
                                        x: parent.width - self.width; y: parent.height + 4px; width: 220px; height: 52px;
                                        Rectangle { background: Theme.dialog; border-radius: 5px; border-width: 1px; border-color: Theme.border;
                                            HorizontalLayout { padding: 8px;
                                                Action { text: "Eliminar de la lista"; text-left: true; clicked => { project-menu.close(); root.close-project(item.path); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.recent-projects.length == 0: Text { text: "Abre un proyecto. Quedará aquí aunque esté en otra carpeta."; color: Theme.muted; wrap: word-wrap; }
                    }
                }
                if root.show-library: TouchArea {
                    width: 4px; mouse-cursor: ew-resize;
                    moved => { if self.pressed { root.library-width = clamp(root.library-width + self.mouse-x, 200px, 340px); } }
                    Rectangle { background: parent.has-hover || parent.pressed ? Theme.splitter-hover : Theme.splitter; }
                }
                if root.show-tree: Rectangle {
                    width: root.tree-width; background: Theme.sidebar;
                    VerticalLayout {
                        padding: 10px; spacing: 8px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: root.project-name == "" ? "Explorador" : root.project-name; color: Theme.heading; font-size: Typography.size + 1px; font-weight: 600; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            Action { text: "«"; accessible-text: "Ocultar el explorador (Ctrl+B)"; clicked => { root.show-tree = false; root.set-panels(root.show-library, false); root.focus-content(); } }
                        }
                        ListView {
                            private property <int> first-visible-row: floor(max(0px, -self.viewport-y) / (root.tree-font-size + 16px));
                            private property <int> visible-row-count: ceil(self.height / (root.tree-font-size + 16px));
                            changed first-visible-row => { root.tree-viewport-changed(self.first-visible-row, self.visible-row-count); }
                            changed visible-row-count => { root.tree-viewport-changed(self.first-visible-row, self.visible-row-count); }
                            for item in root.tree-items: TouchArea {
                                height: root.tree-font-size + 16px;
                                clicked => {
                                    if item.is-dir { root.toggle-folder(item.path, false); }
                                    else { root.open-file(item.path); }
                                    root.focus-content();
                                }
                                Rectangle { border-radius: 3px; background: item.path == root.selected-path ? Theme.tree-selected : parent.has-hover ? Theme.tree-hover : transparent; }
                                HorizontalLayout {
                                    padding-left: item.depth * 12px + 4px; spacing: 6px;
                                    if item.has-thumb: Rectangle {
                                        width: Typography.size + 7px;
                                        height: Typography.size + 7px;
                                        border-radius: 3px;
                                        clip: true;
                                        background: Theme.light ? #e0e5eb : #1b2633;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        y: (parent.height - self.height) / 2;
                                        Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: item.thumb;
                                            image-fit: cover;
                                        }
                                    }
                                    if !item.has-thumb: Text { text: item.icon; font-family: item.icon-family; font-size: Typography.size + 3px; width: Typography.size + 7px; color: item.icon-color; vertical-alignment: center; }
                                    Text { text: item.name; font-size: root.tree-font-size; color: Theme.file-text; overflow: elide; vertical-alignment: center; }
                                }
                            }
                        }
                        if root.tree-items.length == 0 && root.project-path == "" && root.standalone-parent-path != "": VerticalLayout {
                            spacing: 10px; padding-top: 8px;
                            Action { text: "Abrir carpeta en proyectos"; primary: true; clicked => { root.open-project(root.standalone-parent-path); } }
                        }
                        if root.tree-items.length == 0 && (root.project-path != "" || root.standalone-parent-path == ""): Text { text: "Carpeta vacía o sin archivos visibles."; color: Theme.empty-text; wrap: word-wrap; }
                    }
                }
                if root.show-tree: TouchArea {
                    width: 4px; mouse-cursor: ew-resize;
                    moved => { if self.pressed { root.tree-width = clamp(root.tree-width + self.mouse-x, 180px, 400px); } }
                    Rectangle { background: parent.has-hover || parent.pressed ? Theme.splitter-hover : Theme.splitter; }
                }
                VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: Typography.size + 32px; background: Theme.toolbar;
                        HorizontalLayout {
                            padding: 7px; spacing: 8px;
                            Text { text: root.current-file-path == "" ? "Inspeccionar código" : root.current-file-path + (root.is-dirty ? "  ●" : ""); color: Theme.file-text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            if root.selected-path != "" && root.is-image: Action {
                                text: root.image-actual-size ? "Ajustar a ventana" : "Tamaño real (100%)";
                                clicked => { root.image-actual-size = !root.image-actual-size; }
                            }
                            if root.selected-path != "" && root.is-pdf: Action { text: "‹"; accessible-text: "Página anterior"; enabled: root.pdf-page > 0; clicked => { root.pdf-step-page(-1); } }
                            if root.selected-path != "" && root.is-pdf: Text { text: "Pág. " + (root.pdf-page + 1) + " / " + max(1, root.pdf-total-pages); color: Theme.file-text; vertical-alignment: center; }
                            if root.selected-path != "" && root.is-pdf: Action { text: "›"; accessible-text: "Página siguiente"; enabled: root.pdf-page + 1 < root.pdf-total-pages; clicked => { root.pdf-step-page(1); } }
                            if root.selected-path != "" && root.is-pdf && root.pdf-total-pages > 1: Action { text: "Miniaturas"; accessible-text: root.show-pdf-thumbs ? "Ocultar miniaturas de página" : "Mostrar miniaturas de página"; primary: root.show-pdf-thumbs; clicked => { root.show-pdf-thumbs = !root.show-pdf-thumbs; } }
                            if root.selected-path != "" && root.is-pdf: Action { text: "Ajustar"; accessible-text: "Ajustar al ancho (Ctrl+0)"; primary: root.pdf-fit-width; clicked => { root.pdf-zoom(0); } }
                            if root.selected-path != "" && (root.is-pdf || root.doc-mode()): Action { text: "−"; accessible-text: "Alejar (Ctrl+-)"; clicked => { root.zoom-active(-1); } }
                            if root.selected-path != "" && (root.is-pdf || root.doc-mode()): Text { text: (root.is-pdf ? root.pdf-zoom-percent : round(root.doc-zoom * 100)) + "%"; color: Theme.muted; vertical-alignment: center; }
                            if root.selected-path != "" && (root.is-pdf || root.doc-mode()): Action { text: "+"; accessible-text: "Acercar (Ctrl++)"; clicked => { root.zoom-active(1); } }
                            if root.selected-path != "" && root.is-pdf: Action { text: "Copiar página"; clicked => { root.copy-pdf-text(); } }
                            if root.selected-path != "" && root.project-path == "" && root.standalone-parent-path != "": Action { text: "Abrir carpeta"; clicked => { root.open-project(root.standalone-parent-path); } }
                            if root.selected-path != "" && !root.is-image && !root.is-pdf && root.markdown-file && root.preview && root.doc-headings.length > 0: Action { text: "Índice"; primary: root.show-toc; clicked => { root.show-toc = !root.show-toc; } }
                            if root.selected-path != "" && !root.is-image && !root.is-pdf && !root.doc-readonly: Action { text: root.is-sheet ? "Tabla" : root.markdown-file ? "Vista previa" : "Lectura"; primary: root.preview; clicked => { root.preview = true; } }
                            if root.selected-path != "" && !root.is-image && !root.is-pdf && !root.doc-readonly: Action { text: "Editor"; primary: !root.preview; clicked => { root.preview = false; } }
                            if root.selected-path != "" && !root.is-image && !root.is-pdf && !root.doc-readonly: Action { text: ""; icon: "\u{eae2}"; accessible-text: "Deshacer (Ctrl+Z)"; enabled: root.can-undo; clicked => { root.undo(); } }
                            if root.selected-path != "" && !root.is-image && !root.is-pdf && !root.doc-readonly: Action { text: ""; icon: "\u{ebb0}"; accessible-text: "Rehacer (Ctrl+Shift+Z)"; enabled: root.can-redo; clicked => { root.redo(); } }
                            if root.selected-path != "" && !root.is-image: Action { text: ""; icon: "\u{ea6d}"; accessible-text: "Buscar en el archivo (Ctrl+F)"; clicked => { root.show-find = true; root.show-replace = !(root.doc-readonly || root.is-pdf || (root.preview && (root.markdown-file || root.is-sheet))); } }
                            if root.is-dirty && !root.is-image && !root.doc-readonly: Action { text: ""; icon: "\u{ea77}"; accessible-text: "Revertir cambios"; enabled: !root.busy; clicked => { root.revert(); } }
                            if root.is-dirty && !root.is-image && !root.doc-readonly: Action { text: ""; icon: "\u{eb4b}"; accessible-text: "Guardar cambios (Ctrl+S)"; primary: true; enabled: !root.busy; clicked => { root.save(); } }
                        }
                    }
                    if root.recent-files.length > 0: Rectangle {
                        height: Typography.size + 20px; background: Theme.sidebar;
                        ScrollView {
                            viewport-x <=> root.tab-offset;
                            viewport-height: self.height;
                            viewport-width: history.preferred-width;
                            history := HorizontalLayout {
                                spacing: 4px;
                                for item in root.recent-files: Rectangle {
                                    width: 190px; background: root.selected-path == item.path ? Theme.canvas : Theme.sidebar;
                                    Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: root.selected-path == item.path ? Theme.focus : transparent; }
                                    accessible-role: button; accessible-label: "Abrir " + item.path;
                                    Tooltip { Hint { text: item.path; } }
                                    accessible-action-default => { root.open-file(item.path); root.focus-content(); }
                                    tab-keys := FocusScope { key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.open-file(item.path); root.focus-content(); return accept; } reject } }
                                    Rectangle { height: parent.height; width: parent.width; background: transparent; border-width: tab-keys.has-focus ? 1px : 0px; border-color: Theme.focus; }
                                    tab-touch := TouchArea {
                                        clicked => { root.open-file(item.path); root.focus-content(); }
                                        pointer-event(e) => { if e.button == PointerEventButton.middle && e.kind == PointerEventKind.up { root.close-file(item.path); } }
                                    }
                                    Text { x: 12px; y: 0px; height: parent.height; width: parent.width - 52px; text: item.display-path + (root.selected-path == item.path && root.is-dirty ? " ●" : ""); color: Theme.file-text; overflow: elide; vertical-alignment: center; }
                                    Action { width: self.preferred-width; x: parent.width - self.width - 4px; y: (parent.height - self.height) / 2; text: "×"; accessible-text: "Cerrar " + item.display-path; clicked => { root.close-file(item.path); } middle-clicked => { root.close-file(item.path); } }
                                }
                            }
                        }
                    }
                    if root.show-find && root.selected-path != "" && !root.is-image: Rectangle {
                        height: root.show-replace && !root.doc-readonly && !root.is-pdf ? 3 * Typography.size + 68px : 2 * Typography.size + 40px; background: Theme.find-surface;
                        VerticalLayout {
                            padding: 6px; spacing: 4px;
                            HorizontalLayout {
                                spacing: 5px;
                                LineEdit { placeholder-text: "Buscar en el archivo…"; accessible-label: "Buscar texto"; text <=> root.find-query; init => { self.focus(); } accepted => { root.find-next(true); } }
                                Action { text: ""; icon: "\u{eaa1}"; accessible-text: "Coincidencia anterior (Shift+F3)"; clicked => { root.find-next(false); } }
                                Action { text: ""; icon: "\u{ea9a}"; accessible-text: "Coincidencia siguiente (F3)"; clicked => { root.find-next(true); } }
                                Action { text: "Aa"; accessible-text: "Distinguir mayúsculas"; primary: root.find-case; clicked => { root.find-case = !root.find-case; root.find-next(true); } }
                                if !root.is-pdf && !root.is-sheet && !root.markdown-file: Action { text: "ab"; accessible-text: "Palabra completa"; primary: root.find-whole; clicked => { root.find-whole = !root.find-whole; root.find-next(true); } }
                                Action { text: "×"; accessible-text: "Cerrar búsqueda"; clicked => { root.show-find = false; root.show-replace = false; root.focus-content(); } }
                            }
                            if root.show-replace && !root.doc-readonly && !root.is-pdf: HorizontalLayout {
                                spacing: 5px;
                                LineEdit { placeholder-text: "Reemplazar por…"; accessible-label: "Texto de reemplazo"; text <=> root.replace-query; }
                                Action { text: "Reemplazar"; clicked => { root.replace-text(root.find-query, root.replace-query, false, root.find-case, root.find-whole); } }
                                Action { text: "Todos"; accessible-text: "Reemplazar todas las coincidencias"; clicked => { root.replace-text(root.find-query, root.replace-query, true, root.find-case, root.find-whole); } }
                            }
                            HorizontalLayout {
                                Text { text: root.find-summary; color: Theme.muted; font-size: Typography.size - 2px; horizontal-stretch: 1; }
                                Text { text: "Búsqueda literal · Enter / F3"; color: Theme.muted; font-size: Typography.size - 2px; }
                            }
                        }
                    }
                    if root.show-goto: Rectangle {
                        height: Typography.size + 30px; background: Theme.find-surface;
                        HorizontalLayout {
                            padding: 6px; spacing: 6px;
                            LineEdit {
                                placeholder-text: root.is-pdf ? "Ir a la página (1–" + max(1, root.pdf-total-pages) + ")…" : "Ir a la línea (1–" + root.total-lines + ")…";
                                accessible-label: root.is-pdf ? "Número de página" : "Número de línea";
                                text <=> root.goto-input;
                                init => { self.focus(); }
                                accepted => { if root.is-pdf { root.pdf-go-page(self.text); } else { root.go-line(self.text); } }
                            }
                            Action { text: "Ir"; primary: true; clicked => { if root.is-pdf { root.pdf-go-page(root.goto-input); } else { root.go-line(root.goto-input); } } }
                            Action { text: "×"; accessible-text: "Cerrar navegación"; clicked => { root.show-goto = false; root.focus-content(); } }
                        }
                    }
                    viewport := Rectangle {
                        clip: true;
                        private property <int> visible-count: max(1, ceil(self.height / (root.code-font-size + 9px)));
                        changed visible-count => { root.viewport-changed(self.visible-count); }
                        measure := Text { visible: false; text: "0000000000"; font-family: root.code-font-family; font-size: root.code-font-size; }
                        private property <int> wrap-columns: max(4, floor((self.width - 85px) / max(1px, measure.preferred-width / 10)));
                        changed wrap-columns => { root.wrap-columns-changed(self.wrap-columns); }
                        // Width left for a page or a document once side strips and the scrollbar are taken out.
                        private property <length> reading-width: self.width
                            - (root.is-pdf ? 18px + (root.show-pdf-thumbs && root.pdf-total-pages > 1 ? 164px : 0px) : 0px)
                            - (root.markdown-file && root.preview && root.show-toc && root.doc-headings.length > 0 ? 230px : 0px);
                        changed reading-width => { root.reading-width-changed(self.reading-width / 1px); }
                        init => { root.reading-width-changed(self.reading-width / 1px); }
                        if root.selected-path == "": VerticalLayout {
                            padding: 36px; spacing: 16px; alignment: center;
                            Text { text: "Tu código, a mano."; color: Theme.title; font-size: 26px; font-weight: 600; }
                            Text { text: "Elige un proyecto a la izquierda y abre un archivo.\nEncuentra archivos o texto sin salir de aquí."; color: Theme.description; wrap: word-wrap; }
                            HorizontalLayout {
                                alignment: start; spacing: 8px;
                                Action { text: "Buscar"; primary: true; clicked => { root.open-palette(1); } }
                            }
                            Text { text: "Ctrl+P archivos    Ctrl+Shift+F texto    Ctrl+H reemplazar    Ctrl+G ir a línea"; color: Theme.hint; font-size: Typography.size - 1px; }
                        }
                        if root.selected-path != "" && root.is-image: Rectangle {
                            background: Theme.canvas;
                            clip: true;
                            if !root.image-actual-size: Rectangle {
                                Image {
                                    x: 24px;
                                    y: 24px;
                                    width: parent.width - 48px;
                                    height: parent.height - 48px;
                                    source: root.image-source;
                                    image-fit: contain;
                                }
                            }
                            if root.image-actual-size: ScrollView {
                                viewport-width: img-full.preferred-width + 64px;
                                viewport-height: img-full.preferred-height + 64px;
                                HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        padding: 32px;
                                        img-full := Image {
                                            source: root.image-source;
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                y: parent.height - self.height - 14px;
                                x: (parent.width - self.width) / 2;
                                width: info-text.preferred-width + 24px;
                                height: 30px;
                                border-radius: 15px;
                                background: Theme.scrim;
                                border-width: 1px;
                                border-color: Theme.dialog-border;
                                info-text := Text {
                                    x: 12px;
                                    text: root.image-info;
                                    color: #ffffff;
                                    font-size: Typography.size - 1px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.selected-path != "" && !root.is-image && !root.is-pdf && !root.doc-readonly && !root.preview: editor := FocusScope {
                            width: parent.width - 14px; height: parent.height;
                            forward-focus: committed-input;
                            init => { committed-input.focus(); }
                            in property <int> focus-generation: root.focus-generation;
                            changed focus-generation => { if !root.modal { committed-input.focus(); } }
                            capture-key-pressed(e) => {
                                if root.modal { return reject; }
                                if e.modifiers.control && (e.text == "a" || e.text == "A" || e.text == "\u{1}") { root.editor-action("select-all", e); return accept; }
                                if e.modifiers.control && (e.text == "c" || e.text == "C" || e.text == "\u{3}") { root.editor-copy(false); return accept; }
                                if e.modifiers.control && (e.text == "x" || e.text == "X" || e.text == "\u{18}") { root.editor-copy(true); return accept; }
                                if e.modifiers.control && (e.text == "v" || e.text == "V" || e.text == "\u{16}") { root.paste-content(); return accept; }
                                if e.modifiers.shift && e.text == Key.Insert { root.paste-content(); return accept; }
                                if e.modifiers.control && e.text == Key.Insert { root.editor-copy(false); return accept; }
                                if e.modifiers.shift && e.text == Key.Delete { root.editor-copy(true); return accept; }
                                if e.modifiers.control && e.text == "/" { root.editor-action("comment", e); return accept; }
                                if e.modifiers.control && (e.text == "d" || e.text == "D" || e.text == "\u{4}") { root.editor-action("duplicate", e); return accept; }
                                if e.text == Key.LeftArrow { root.editor-action("left", e); return accept; }
                                if e.text == Key.RightArrow { root.editor-action("right", e); return accept; }
                                if e.text == Key.UpArrow { root.editor-action("up", e); return accept; }
                                if e.text == Key.DownArrow { root.editor-action("down", e); return accept; }
                                if e.text == Key.Home { root.editor-action("home", e); return accept; }
                                if e.text == Key.End { root.editor-action("end", e); return accept; }
                                if e.text == Key.PageUp { root.editor-command(root.selected-path, "page-up", viewport.visible-count, e.modifiers.shift, e.modifiers.control); return accept; }
                                if e.text == Key.PageDown { root.editor-command(root.selected-path, "page-down", viewport.visible-count, e.modifiers.shift, e.modifiers.control); return accept; }
                                if e.text == Key.Backspace { root.editor-action("backspace", e); return accept; }
                                if e.text == Key.Delete { root.editor-action("delete", e); return accept; }
                                if e.text == Key.Return { root.editor-action("newline", e); return accept; }
                                if e.text == Key.Tab || e.text == Key.Backtab { root.editor-command(root.selected-path, "indent", "", e.modifiers.shift || e.text == Key.Backtab, false); return accept; }
                                reject
                            }
                            private property <length> cell: max(1px, measure.preferred-width / 10);
                            private property <length> row-height: root.code-font-size + 9px;
                            private property <length> caret-y: (root.caret-line - root.first-line) * self.row-height;
                            for row[index] in root.editor-rows: Rectangle {
                                y: index * editor.row-height; height: editor.row-height; width: parent.width;
                                background: row.line-number == root.caret-line ? Theme.line-selected : transparent;
                                Text { x: 0px; y: 0px; height: parent.height; width: 53px; text: row.line-number; color: row.line-number == root.caret-line ? Theme.file-text : Theme.line-number; font-family: root.code-font-family; font-size: root.code-font-size; horizontal-alignment: right; vertical-alignment: center; }
                                Rectangle { x: 61px; width: 1px; background: Theme.border; }
                                Rectangle {
                                    x: 72px; width: parent.width - 72px; height: parent.height; clip: true;
                                    Rectangle { x: row.selection-start * editor.cell; width: max(0, row.selection-end - row.selection-start) * editor.cell; background: Theme.code-selection; }
                                    for span in row.spans: Text { x: span.column * editor.cell; y: 0px; height: parent.height; text: span.text; color: span.color; font-family: root.code-font-family; font-size: root.code-font-size; vertical-alignment: center; }
                                }
                            }
                            if committed-input.has-focus && root.caret-line >= root.first-line && editor.caret-y < editor.height: Rectangle {
                                x: 72px + root.caret-column * editor.cell; y: editor.caret-y + 3px;
                                width: 2px; height: editor.row-height - 6px; background: Theme.focus;
                            }
                            committed-input := TextInput {
                                x: 72px + root.caret-column * editor.cell; y: clamp(editor.caret-y, 0px, editor.height - editor.row-height);
                                width: max(1px, editor.width - self.x); height: editor.row-height;
                                font-family: root.code-font-family; font-size: root.code-font-size;
                                color: transparent; text-cursor-width: 0px; single-line: true;
                                accessible-label: "Editor de código: " + root.current-file-path;
                                edited => { root.editor-command(root.selected-path, "insert", self.text, false, false); self.text = ""; }
                            }
                            if committed-input.preedit-text != "": Text {
                                x: committed-input.x; y: committed-input.y; height: editor.row-height;
                                text: committed-input.preedit-text; color: Theme.file-text;
                                font-family: root.code-font-family; font-size: root.code-font-size; vertical-alignment: center;
                            }
                            editor-touch := TouchArea {
                                mouse-cursor: text;
                                pointer-event(e) => {
                                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                        committed-input.focus();
                                        root.editor-point(root.selected-path, root.first-line + floor(self.mouse-y / editor.row-height), root.left-column + max(0, round((self.mouse-x - 72px) / editor.cell)), e.modifiers.shift);
                                    }
                                }
                                double-clicked => { root.editor-command(root.selected-path, "select-word", "", false, false); }
                                moved => { if self.pressed { root.editor-point(root.selected-path, root.first-line + floor(self.mouse-y / editor.row-height), root.left-column + max(0, round((self.mouse-x - 72px) / editor.cell)), true); } }
                                scroll-event(e) => { if e.modifiers.shift { root.editor-pan(e.delta-y < 0px ? 8 : -8); } else if e.delta-x != 0px { root.editor-pan(e.delta-x < 0px ? 8 : -8); } else if e.delta-y != 0px { root.editor-scroll(e.delta-y < 0px ? 3 : -3); } accept }
                            }
                            ContextMenuArea {
                                Menu {
                                    MenuItem { title: "Copiar"; activated => { root.editor-copy(false); } }
                                    MenuItem { title: "Cortar"; activated => { root.editor-copy(true); } }
                                    MenuItem { title: "Pegar"; activated => { root.paste-content(); } }
                                    MenuItem { title: "Seleccionar todo"; activated => { root.editor-command(root.selected-path, "select-all", "", false, false); } }
                                }
                            }
                        }
                        if root.selected-path != "" && !root.is-image && root.markdown-file && root.preview: HorizontalLayout {
                            spacing: 0px;
                            if root.show-toc && root.doc-headings.length > 0: Rectangle {
                                width: 230px; background: Theme.sidebar;
                                border-width: 1px; border-color: Theme.border;
                                VerticalLayout {
                                    padding: 10px; spacing: 6px;
                                    Text { text: "Contenido"; color: Theme.heading; font-weight: 600; font-size: Typography.size; }
                                    ListView {
                                        for heading in root.doc-headings: TouchArea {
                                            height: Typography.size + 14px;
                                            clicked => { root.jump-doc-block(heading.block-index); root.focus-content(); }
                                            Rectangle { border-radius: 4px; background: parent.has-hover ? Theme.tree-hover : transparent; }
                                            Text {
                                                x: max(0, heading.level - 1) * 12px + 6px;
                                                width: parent.width - self.x - 6px;
                                                text: heading.title;
                                                color: Theme.file-text;
                                                font-size: Typography.size - 1px;
                                                font-weight: heading.level == 1 ? 600 : 400;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                            doc-scroll := ScrollView {
                                horizontal-stretch: 1;
                                viewport-width: self.visible-width;
                                viewport-height: doc-content.preferred-height;
                                doc-content := VerticalLayout {
                                    width: doc-scroll.visible-width;
                                    padding-left: max(28px, (doc-scroll.visible-width - 860px * root.doc-zoom) / 2);
                                    padding-right: max(28px, (doc-scroll.visible-width - 860px * root.doc-zoom) / 2);
                                    padding-top: 24px;
                                    padding-bottom: 36px;
                                    spacing: 10px;
                                    alignment: start;
                                    if root.doc-has-more-before: HorizontalLayout {
                                        alignment: center;
                                        Action { text: "Cargar bloques anteriores (" + root.doc-window-start + " ocultos)"; clicked => { root.step-doc-window(false); } }
                                    }
                                    for block in root.doc-blocks: Rectangle {
                                        accessible-role: list-item;
                                        accessible-label: "doc-block-" + block.index;
                                        // Índice and search results scroll their block into view.
