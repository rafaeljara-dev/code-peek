                                                    image-fit: contain;
                                                }
                                                Text { text: block.image-alt; color: Theme.caption; font-size: root.doc-font - 1px; wrap: word-wrap; }
                                            }
                                            if block.kind == 7: VerticalLayout {
                                                padding-top: 6px; padding-bottom: 6px;
                                                Rectangle { height: 1px; background: Theme.border; }
                                            }
                                            if block.links.length > 0: HorizontalLayout {
                                                padding-top: 2px; spacing: 6px; alignment: start;
                                                for lnk in block.links: Action { text: lnk.label; clicked => { root.open-doc-link(lnk.url); } }
                                            }
                                        }
                                    }
                                    if root.doc-has-more-after: HorizontalLayout {
                                        alignment: center;
                                        Action { text: "Cargar bloques siguientes"; clicked => { root.step-doc-window(true); } }
                                    }
                                }
                            }
                        }
                        if root.selected-path != "" && root.is-sheet && root.preview: VerticalLayout {
                            spacing: 0px;
                            Rectangle {
                                height: Typography.size + 26px; background: Theme.sidebar;
                                border-width: 1px; border-color: Theme.border;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 6px; alignment: start;
                                    for tab[idx] in root.sheet-tabs: Action {
                                        text: tab;
                                        primary: idx == root.active-sheet;
                                        clicked => { root.select-sheet(idx); root.focus-content(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.sheet-has-prev-cols: Action { text: "‹ Cols"; clicked => { root.step-sheet-cols(false); } }
                                    if root.sheet-has-next-cols: Action { text: "Cols ›"; clicked => { root.step-sheet-cols(true); } }
                                    if root.sheet-has-prev-rows: Action { text: "‹ Filas"; clicked => { root.step-sheet-rows(false); } }
                                    if root.sheet-has-next-rows: Action { text: "Filas ›"; clicked => { root.step-sheet-rows(true); } }
                                    Action { text: "Copiar fila"; clicked => { root.copy-sheet-row(); } }
                                }
                            }
                            Rectangle {
                                height: Typography.size + 18px; background: Theme.canvas;
                                border-width: 1px; border-color: Theme.border;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 12px;
                                    Text { width: 72px; text: root.sheet-cell-ref; color: Theme.muted; font-family: root.code-font-family; vertical-alignment: center; accessible-label: "Celda seleccionada"; }
                                    Text { text: root.sheet-cell-text; color: Theme.file-text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; accessible-label: "Contenido de la celda"; }
                                }
                            }
                            if root.sheet-truncated: Rectangle {
                                height: Typography.size + 14px; background: Theme.find-surface;
                                Text { x: 10px; text: "Hoja demasiado grande: solo se cargó la primera parte."; color: Theme.muted; font-size: Typography.size - 2px; vertical-alignment: center; }
                            }
                            Rectangle {
                                height: root.doc-font + 16px; background: Theme.sidebar; clip: true;
                                // Column letters stay put while the rows scroll underneath.
                                HorizontalLayout {
                                    x: sheet-scroll.viewport-x; width: self.preferred-width; height: parent.height;
                                    spacing: 0px; alignment: start;
                                    Rectangle {
                                        width: root.doc-font * 3.8; background: Theme.sidebar;
                                        border-width: 1px; border-color: Theme.border;
                                        Text { text: "#"; color: Theme.line-number; font-size: root.doc-font - 1px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    for col in root.sheet-headers: Rectangle {
                                        width: col.width * root.doc-font / 10; background: Theme.sidebar;
                                        border-width: 1px; border-color: Theme.border;
                                        Text { text: col.label; color: Theme.heading; font-size: root.doc-font - 1px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                            sheet-scroll := ScrollView {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                viewport-width: sheet-grid.preferred-width;
                                viewport-height: sheet-grid.preferred-height;
                                sheet-grid := VerticalLayout {
                                    padding: 0px; spacing: 0px; alignment: start;
                                    for row in root.sheet-rows: HorizontalLayout {
                                        height: root.doc-font + 16px; spacing: 0px; alignment: start;
                                        Rectangle {
                                            width: root.doc-font * 3.8; background: Theme.sidebar;
                                            border-width: 1px; border-color: Theme.border;
                                            Text { text: row.row-number; color: Theme.line-number; font-family: root.code-font-family; font-size: root.doc-font - 2px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        for cell[ci] in row.cells: Rectangle {
                                            width: root.sheet-headers[ci].width * root.doc-font / 10;
                                            background: cell.selected ? Theme.code-selection : cell.matched ? Theme.find-surface : transparent;
                                            border-width: cell.selected ? 2px : 1px;
                                            border-color: cell.selected ? Theme.focus : Theme.border;
                                            TouchArea {
                                                clicked => { root.select-sheet-cell(row.row-number - 1, cell.col-index); root.focus-content(); }
                                            }
                                            ContextMenuArea {
                                                Menu {
                                                    MenuItem { title: "Copiar celda"; activated => { root.select-sheet-cell(row.row-number - 1, cell.col-index); root.copy-sheet-cell(); } }
                                                    MenuItem { title: "Copiar fila completa"; activated => { root.select-sheet-cell(row.row-number - 1, cell.col-index); root.copy-sheet-row(); } }
                                                }
                                            }
                                            Text {
                                                x: 8px; width: parent.width - 16px; height: parent.height;
                                                text: cell.text;
                                                color: cell.kind == 5 ? Theme.error-text : cell.kind == 2 ? (Theme.light ? #0369a1 : #7dd3fc) : cell.kind == 3 ? (Theme.light ? #9333ea : #d8b4fe) : cell.kind == 4 ? (Theme.light ? #0f766e : #5eead4) : Theme.file-text;
                                                font-family: cell.kind == 2 ? root.code-font-family : "Segoe UI";
                                                font-size: root.doc-font - 1px;
                                                horizontal-alignment: cell.kind == 2 || cell.kind == 4 ? right : left;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.selected-path != "" && root.is-pdf: HorizontalLayout {
                            spacing: 0px;
                            if root.show-pdf-thumbs && root.pdf-total-pages > 1: Rectangle {
                                width: 164px; background: Theme.sidebar;
                                border-width: 1px; border-color: Theme.border;
                                // Keep the current page's thumbnail in view while paging.
                                property <int> current: root.pdf-page;
                                changed current => {
                                    if -thumb-list.viewport-y > self.current * thumb-list.row-height {
                                        thumb-list.viewport-y = -self.current * thumb-list.row-height;
                                    } else if -thumb-list.viewport-y + thumb-list.height < (self.current + 1) * thumb-list.row-height {
                                        thumb-list.viewport-y = thumb-list.height - (self.current + 1) * thumb-list.row-height;
                                    }
                                }
                                thumb-list := ListView {
                                    property <length> row-height: root.pdf-thumb-height * 1px + 36px;
                                    private property <int> first-row: floor(max(0px, -self.viewport-y) / self.row-height);
                                    private property <int> row-count: ceil(self.height / self.row-height) + 1;
                                    changed first-row => { root.pdf-thumbs-viewport(self.first-row, self.row-count); }
                                    changed row-count => { root.pdf-thumbs-viewport(self.first-row, self.row-count); }
                                    for item in root.pdf-thumbs: TouchArea {
                                        height: thumb-list.row-height;
                                        accessible-role: button;
                                        accessible-label: "Ir a la página " + (item.page + 1);
                                        clicked => { root.pdf-go-page(item.page + 1); root.focus-content(); }
                                        Rectangle {
                                            x: (parent.width - self.width) / 2; y: 6px;
                                            width: 140px; height: root.pdf-thumb-height * 1px + 8px;
                                            border-radius: 4px; background: #ffffff;
                                            border-width: item.page == root.pdf-page ? 3px : 1px;
                                            border-color: item.page == root.pdf-page ? Theme.focus : Theme.border;
                                            if item.has-image: Image {
                                                x: 4px; y: 4px; width: 132px; height: root.pdf-thumb-height * 1px;
                                                source: item.image; image-fit: contain;
                                            }
                                        }
                                        Text {
                                            y: parent.height - 20px; height: 16px; width: parent.width;
                                            text: item.page + 1;
                                            color: item.page == root.pdf-page ? Theme.focus : Theme.muted;
                                            font-size: Typography.size - 2px; font-weight: item.page == root.pdf-page ? 700 : 400;
                                            horizontal-alignment: center; vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                background: Theme.canvas;
                                clip: true;
                                horizontal-stretch: 1;
                                // Wheel events the page cannot use (already at an edge) turn the page.
                                TouchArea {
                                    scroll-event(e) => {
                                        if e.delta-y < 0px { root.pdf-wheel-page(1); return accept; }
                                        if e.delta-y > 0px { root.pdf-wheel-page(-1); return accept; }
                                        reject
                                    }
                                    pdf-scroll := ScrollView {
                                        property <int> page: root.pdf-page;
                                        changed page => { self.viewport-y = 0px; }
                                        viewport-width: max(self.visible-width, root.pdf-page-width * 1px + 48px);
                                        viewport-height: max(self.visible-height, root.pdf-page-height * 1px + 48px);
                                        Rectangle {
                                            x: max(24px, (pdf-scroll.viewport-width - self.width) / 2);
                                            y: 24px;
                                            width: max(1px, root.pdf-page-width * 1px);
                                            height: max(1px, root.pdf-page-height * 1px);
                                            background: #ffffff;
                                            drop-shadow-blur: 12px;
                                            drop-shadow-color: #00000040;
                                            // Laid out at the page's logical size; the bitmap carries the screen's real pixels.
                                            Image {
                                                source: root.pdf-image;
                                                width: parent.width;
                                                height: parent.height;
                                                image-fit: fill;
                                            }
                                        }
                                    }
                                }
                                if root.pdf-loading: Rectangle {
                                    y: 16px;
                                    x: (parent.width - self.width) / 2;
                                    width: pdf-load-label.preferred-width + 24px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: Theme.scrim;
                                    border-width: 1px;
                                    border-color: Theme.dialog-border;
                                    pdf-load-label := Text {
                                        x: 12px;
                                        text: "Renderizando página…";
                                        color: #ffffff;
                                        font-size: Typography.size - 1px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        if root.selected-path != "" && !root.is-image && !root.is-pdf && !root.markdown-file && !root.is-sheet && root.preview: TouchArea {
                            width: parent.width - 14px;
                            scroll-event(e) => {
                                if !root.show-edit && e.delta-y != 0px { root.scroll-lines(e.delta-y < 0px ? 3 : -3); }
                                accept
                            }
                            VerticalLayout {
                                padding: 0px; spacing: 0px; alignment: start;
                                for line in root.code-lines: Rectangle {
                                    height: root.code-font-size + (line.is-markdown && line.line-type == 1 ? 18px : line.is-markdown && line.line-type == 2 ? 14px : line.is-markdown && line.line-type == 3 ? 11px : 9px);
                                    background: line.line-number == root.selected-line ? Theme.line-selected : transparent;
                                    clip: true;
                                    Text { x: 0px; width: 53px; text: line.continuation ? "" : "\{line.line-number}"; color: Theme.line-number; font-family: root.code-font-family; font-size: root.code-font-size; horizontal-alignment: right; vertical-alignment: center; }
                                    Rectangle {
                                        x: 65px; width: parent.width - 65px; height: parent.height; clip: true;
                                        HorizontalLayout {
                                            width: parent.width; height: parent.height;
                                            padding: 0px; spacing: 0px; alignment: start;
                                            for span in line.spans: Text {
                                                text: span.text; color: span.color; font-family: root.code-font-family;
                                                font-size: root.code-font-size + (line.is-markdown && line.line-type == 1 ? 8px : line.is-markdown && line.line-type == 2 ? 5px : line.is-markdown && line.line-type == 3 ? 3px : 0px);
                                                font-weight: span.bold ? 700 : 400; font-italic: span.italic; vertical-alignment: center;
                                            }
                                        }
                                    }
                                    if !root.show-edit: TouchArea { clicked => { root.select-line(line.line-number); root.focus-content(); } double-clicked => { root.edit-line(line.line-number); } }
                                    if root.show-edit && line.line-number == root.selected-line && !line.continuation: Rectangle {
                                        x: 61px; width: parent.width - 65px; height: parent.height; background: Theme.canvas;
                                        inline-edit := LineEdit { text <=> root.edit-text; font-family: root.code-font-family; font-size: root.code-font-size; init => { self.focus(); } accepted => { root.apply-edit(self.text); } }
                                    }
                                }
                            }
                        }
                        if root.selected-path != "" && !root.is-image && !root.is-pdf && !(root.markdown-file && root.preview) && !(root.is-sheet && root.preview): Rectangle {
                            x: parent.width - 14px; width: 14px; height: parent.height; background: Theme.toolbar;
                            TouchArea {
                                pointer-event(e) => { if e.button == PointerEventButton.left { root.scroll-content(clamp((self.mouse-y - thumb.height / 2) / max(1px, self.height - thumb.height), 0, 1)); } }
                                moved => { if self.pressed { root.scroll-content(clamp((self.mouse-y - thumb.height / 2) / max(1px, self.height - thumb.height), 0, 1)); } }
                                thumb := Rectangle { x: 3px; width: 8px; height: min(parent.height, max(28px, (root.preview ? root.visible-ratio : root.editor-visible-ratio) * parent.height)); y: (root.preview ? root.scroll-ratio : root.editor-scroll-ratio) * (parent.height - self.height); border-radius: 4px; background: parent.has-hover ? Theme.scroll-hover : Theme.scroll-thumb; }
                            }
                        }
                    }

                }
            }
            Rectangle {
                height: Typography.size + 20px; background: Theme.header;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 10px;
                    Text { text: root.show-edit ? "Editando en el archivo · Enter aplica · Esc cancela" : root.busy ? "Cargando…" : root.status-info + (root.indexing ? " · Indexando archivos…" : ""); color: Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    if root.selected-path != "" && !root.is-image && !root.is-pdf && !root.is-sheet: Text { text: root.language-name + " · Ln " + root.caret-line + ", Col " + root.cursor-column; color: Theme.muted; vertical-alignment: center; }
                    if root.selected-path != "" && root.is-sheet: Text { text: root.sheet-total-rows + " filas · " + root.sheet-total-cols + " cols"; color: Theme.muted; vertical-alignment: center; }
                    if root.selected-path != "" && root.is-pdf: Text { text: "PDF · Pág. " + (root.pdf-page + 1) + " / " + max(1, root.pdf-total-pages); color: Theme.muted; vertical-alignment: center; }
                    Text { text: root.selected-path == "" || root.is-image || root.is-pdf || root.doc-readonly ? "" : root.is-dirty ? "● Sin guardar" : "Guardado"; color: Theme.muted; vertical-alignment: center; }
                }
            }
        }

        if root.modal: Rectangle {
            background: Theme.scrim;
            TouchArea { clicked => { if root.palette-mode > 0 { root.palette-mode = 0; } if root.show-settings { root.show-settings = false; } root.show-about = false; root.focus-content(); } }
            Rectangle {
                width: min(680px, parent.width - 60px);
                height: min(parent.height - 48px, root.show-settings ? 660px : root.show-about ? 410px : (root.palette-mode > 0 ? 460px : root.show-confirm ? 280px : 310px) + (root.error-message != "" && root.show-confirm ? 70px : 0px));
                x: (parent.width - self.width) / 2; y: min(72px, (parent.height - self.height) / 2);
                background: Theme.dialog; border-radius: 10px; border-width: 1px; border-color: Theme.dialog-border;
                TouchArea {}
                if root.palette-mode > 0: VerticalLayout {
                    padding: 20px; spacing: 12px;
                    HorizontalLayout {
                        Text { text: root.palette-mode == 2 ? "Cambiar de proyecto" : "Buscar en el proyecto"; font-size: Typography.size + 4px; font-weight: 600; color: Theme.title; horizontal-stretch: 1; }
                        Action { text: "×"; clicked => { root.palette-mode = 0; root.focus-content(); } middle-clicked => { root.palette-mode = 0; root.focus-content(); } }
                    }
                    if root.palette-mode != 2: HorizontalLayout {
                        spacing: 8px;
                        Action { text: "Archivos"; primary: root.palette-mode == 1; clicked => { root.palette-mode = 1; root.result-index = 0; root.search-results = []; root.search(root.query, 1); } }
                        Action { text: "Texto"; primary: root.palette-mode == 4; clicked => { root.palette-mode = 4; root.result-index = 0; root.search-results = []; root.search(root.query, 4); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    input := LineEdit { placeholder-text: root.palette-mode == 2 ? "Nombre o ruta de una carpeta…" : root.palette-mode == 4 ? "Texto dentro de los archivos…" : "Nombre o ruta del archivo…"; text <=> root.query; init => { self.focus(); } edited => { root.result-index = 0; root.search-results = []; root.search(self.text, root.palette-mode); } }
                    results := ListView {
                        viewport-y: -max(0px, root.result-index * 36px - self.height + 36px);
                        for item[index] in root.search-results: TouchArea {
                            height: 36px;
                            clicked => { root.result-index = index; root.choose-result(); }
                            Rectangle { border-radius: 4px; background: index == root.result-index ? Theme.result-selected : parent.has-hover ? Theme.result-hover : transparent; }
                            Text { x: 10px; width: parent.width - 20px; text: item.display-path; color: Theme.result-text; overflow: elide; vertical-alignment: center; }
                        }
                    }
                    if root.search-results.length == 0: Text { text: root.content-searching || root.busy || (root.indexing && root.palette-mode != 2) ? "Buscando…" : root.palette-mode == 4 && root.content-query-short ? "Escribe al menos dos caracteres." : "Sin resultados. Prueba otra búsqueda o abre una carpeta."; color: Theme.dialog-description; wrap: word-wrap; }
                    Text { text: "↑ ↓ seleccionar     Enter abrir     Esc cerrar"; color: Theme.dialog-hint; font-size: Typography.size - 1px; }
                }
                if root.show-path: VerticalLayout {
                    padding: 22px; spacing: 14px;
                    HorizontalLayout {
                    Text { text: "Abrir una carpeta"; font-size: Typography.size + 5px; color: Theme.title; font-weight: 600; }
                        Action { text: "×"; clicked => { root.show-path = false; root.focus-content(); } middle-clicked => { root.show-path = false; root.focus-content(); } }
                    }
                    Text { text: "Elige una carpeta con Examinar o pega su ruta. El proyecto quedará guardado en tu lista."; color: Theme.dialog-description; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit { text <=> root.path-input; placeholder-text: "Ruta de una carpeta"; init => { self.focus(); } accepted => { root.open-project(root.path-input); root.show-path = false; root.focus-content(); } }
                        Action { text: "Examinar…"; enabled: !root.browsing; clicked => { root.browsing = true; root.browse-folder(root.path-input); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Action { text: "Cancelar"; clicked => { root.show-path = false; root.focus-content(); } }
                        Action { text: "Abrir proyecto"; primary: true; clicked => { root.open-project(root.path-input); root.show-path = false; root.focus-content(); } }
                    }
                }
                if root.show-about: ScrollView { VerticalLayout {
                    padding: 22px; spacing: 12px;
                    HorizontalLayout {
                        Text { text: "Acerca de CodePeek"; font-size: Typography.size + 5px; color: Theme.title; font-weight: 600; horizontal-stretch: 1; }
                        Action { text: "×"; accessible-text: "Cerrar Acerca de"; clicked => { root.show-about = false; root.focus-content(); } }
                    }
                    Text { text: "Inspector y editor de código nativo · Código propio bajo MIT"; color: Theme.dialog-description; wrap: word-wrap; }
                    Rectangle { height: 132px; background: Palette.background; border-radius: 6px; AboutSlint { } }
                    Text { text: "Los avisos de dependencias y fuentes acompañan a la aplicación en THIRD-PARTY-NOTICES.md."; color: Theme.dialog-description; wrap: word-wrap; }
                } }
                if root.show-settings: ScrollView { VerticalLayout {
                    padding: 22px; spacing: 18px;
                    HorizontalLayout {
                        Text { text: "Configuración"; font-size: Typography.size + 5px; color: Theme.title; font-weight: 600; horizontal-stretch: 1; }
                        Action { text: "×"; clicked => { root.show-settings = false; root.focus-content(); } middle-clicked => { root.show-settings = false; root.focus-content(); } }
                    }
                    Text { text: "Apariencia"; color: Theme.title; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Tema"; color: Theme.dialog-description; vertical-alignment: center; horizontal-stretch: 1; }
                        Action { text: root.light-mode ? "Claro" : "Oscuro"; primary: true; clicked => { root.toggle-theme(); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Interfaz"; color: Theme.dialog-description; vertical-alignment: center; horizontal-stretch: 1; }
                        Action { text: "−"; clicked => { root.zoom-ui(-1); } }
                        Text { text: "\{round(root.ui-font-size / 1px)} px"; color: Theme.dialog-description; vertical-alignment: center; }
                        Action { text: "+"; clicked => { root.zoom-ui(1); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Código"; color: Theme.dialog-description; vertical-alignment: center; horizontal-stretch: 1; }
                        Action { text: "−"; clicked => { root.zoom(-1); } }
                        Text { text: "\{round(root.code-font-size / 1px)} px"; color: Theme.dialog-description; vertical-alignment: center; }
                        Action { text: "+"; clicked => { root.zoom(1); } }
                    }
                    Text { text: "Paneles"; color: Theme.title; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Lista de proyectos"; color: Theme.dialog-description; vertical-alignment: center; horizontal-stretch: 1; }
                        Action { text: root.show-library ? "Visible" : "Oculta"; primary: root.show-library; clicked => { root.show-library = !root.show-library; root.set-panels(root.show-library, root.show-tree); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Explorador de archivos"; color: Theme.dialog-description; vertical-alignment: center; horizontal-stretch: 1; }
                        Action { text: root.show-tree ? "Visible" : "Oculto"; primary: root.show-tree; clicked => { root.show-tree = !root.show-tree; root.set-panels(root.show-library, root.show-tree); } }
                    }
                    Text { text: "Inicio"; color: Theme.title; font-weight: 600; }
                    Text { text: root.default-path == "" ? "Se abrirá el último proyecto usado." : "Proyecto predeterminado: " + root.default-path; color: Theme.dialog-description; overflow: elide; }
                    HorizontalLayout {
                        spacing: 8px;
                        Action { text: root.default-path == root.project-path && root.project-path != "" ? "Quitar proyecto predeterminado" : "Usar el proyecto actual"; enabled: root.project-path != ""; clicked => { root.set-default(); } }
                        Action { text: "Ir al predeterminado"; enabled: root.default-path != ""; clicked => { root.go-default(); root.show-settings = false; } }
                    }
                    Text { text: "Lectura y archivos"; color: Theme.title; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Markdown al abrir"; color: Theme.dialog-description; vertical-alignment: center; horizontal-stretch: 1; }
                        Action { text: root.markdown-default-preview ? "Vista previa" : "Editor"; primary: root.markdown-default-preview; clicked => { root.toggle-markdown-default-preview(); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Archivos sueltos"; color: Theme.dialog-description; vertical-alignment: center; horizontal-stretch: 1; }
                        Action { text: root.open-single-file-without-project ? "Visor rápido" : "Abrir carpeta"; primary: root.open-single-file-without-project; clicked => { root.toggle-single-file-mode(); } }
                    }
                    if root.windows-integration-supported: Text { text: "Integración con Windows"; color: Theme.title; font-weight: 600; }
                    if root.windows-integration-supported: HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Menú contextual «Abrir con CodePeek»"; color: Theme.dialog-description; vertical-alignment: center; horizontal-stretch: 1; }
                        Action { text: root.windows-context-menu ? "Activado" : "Desactivado"; primary: root.windows-context-menu; clicked => { root.windows-context-menu = !root.windows-context-menu; root.set-windows-integration(root.windows-context-menu, root.windows-open-with-markdown, root.windows-open-with-code, root.windows-open-with-docs); } }
                    }
                    if root.windows-integration-supported: HorizontalLayout {
                        spacing: 10px;
                        Text { text: "«Abrir con» para Markdown (.md)"; color: Theme.dialog-description; vertical-alignment: center; horizontal-stretch: 1; }
                        Action { text: root.windows-open-with-markdown ? "Activado" : "Desactivado"; primary: root.windows-open-with-markdown; clicked => { root.windows-open-with-markdown = !root.windows-open-with-markdown; root.set-windows-integration(root.windows-context-menu, root.windows-open-with-markdown, root.windows-open-with-code, root.windows-open-with-docs); } }
                    }
                    if root.windows-integration-supported: HorizontalLayout {
                        spacing: 10px;
                        Text { text: "«Abrir con» para código y texto"; color: Theme.dialog-description; vertical-alignment: center; horizontal-stretch: 1; }
                        Action { text: root.windows-open-with-code ? "Activado" : "Desactivado"; primary: root.windows-open-with-code; clicked => { root.windows-open-with-code = !root.windows-open-with-code; root.set-windows-integration(root.windows-context-menu, root.windows-open-with-markdown, root.windows-open-with-code, root.windows-open-with-docs); } }
                    }
                    if root.windows-integration-supported: HorizontalLayout {
                        spacing: 10px;
                        Text { text: "«Abrir con» para documentos (PDF, Excel, Word)"; color: Theme.dialog-description; vertical-alignment: center; horizontal-stretch: 1; }
                        Action { text: root.windows-open-with-docs ? "Activado" : "Desactivado"; primary: root.windows-open-with-docs; clicked => { root.windows-open-with-docs = !root.windows-open-with-docs; root.set-windows-integration(root.windows-context-menu, root.windows-open-with-markdown, root.windows-open-with-code, root.windows-open-with-docs); } }
                    }
                    if root.windows-integration-supported: HorizontalLayout {
                        spacing: 10px;
                        Text { text: root.windows-integration-status; color: Theme.dialog-hint; font-size: Typography.size - 1px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Action { text: "Aplicar en Windows"; primary: true; enabled: !root.busy; clicked => { root.apply-windows-integration(); } }
                    }
                } }
                if root.show-confirm: VerticalLayout {
                    padding: 22px; spacing: 16px;
                    HorizontalLayout {
                    Text { text: "Tienes cambios sin guardar"; font-size: Typography.size + 5px; color: Theme.title; font-weight: 600; }
                        Action { text: "×"; clicked => { root.resolve-pending(0); } middle-clicked => { root.resolve-pending(0); } }
                    }
                    Text { text: "Guarda antes de continuar o descarta tus cambios locales. Cancelar mantiene el archivo abierto."; color: Theme.dialog-description; wrap: word-wrap; }
                    if root.error-message != "": Text { text: root.error-message; color: Theme.dialog-error; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        Action { text: "Cancelar"; init => { self.focus(); } clicked => { root.resolve-pending(0); } }
                        Action { text: "Descartar"; clicked => { root.resolve-pending(1); } }
                        Action { text: "Guardar y continuar"; primary: true; clicked => { root.resolve-pending(2); } }
                    }
                }
            }
        }
    }
}
